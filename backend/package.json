{
  "type": "module",
  "name": "backend",
  "version": "1.0.0",
  "main": "api/app.js",
  "scripts": {
    "start": "node api/app.js",
    "dev": "nodemon api/app.js",
    "ci-test": "npm run newman-server",
    "newman-server": "cross-env-shell PORT_DENTIST_API=5007 PORT_GATEWAY=3000 \"npm run dropdb && run-p --race start-dentistAPI start-APIGateway start-services newman-wait\"",
    "start-dentistAPI": "node dentistAPI/app.js", 
    "start-APIGateway": "node api/app.js",
    "start-services": "node services/monitoring-service/index.js",
    "newman-wait": "wait-on http://localhost:$PORT_DENTIST_API && wait-on http://localhost:$PORT_GATEWAY && npm run newman",
    "newman": "newman run ./tests/Dentist Direct API.postman_collection.json",
    "dropdb": "node ./tests/dropdb.js"

  },
  "keywords": [],
