  "description": "",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "mqtt": "^5.10.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "newman": "^6.2.1",
    "nodemon": "^3.1.7",
    "text-table": "^0.2.0"
  }
}
