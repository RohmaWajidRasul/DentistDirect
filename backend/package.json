{
  "type": "module",
  "name": "backend",
  "version": "1.0.0",
  "main": "api/app.js",
  "scripts": {
    "start": "node api/app.js",
    "dev": "nodemon api/app.js",
    "ci-test": "npm run newman-server && npm run test",
    "newman-server": "npm run dropdb && run-p --race start-dentistAPI start-APIGateway start-services newman-wait",
    "start-dentistAPI": "node dentistAPI/app.js",
    "start-APIGateway": "node api/app.js",
    "start-services": "node services/load-balancer/index.js",
    "newman-wait": "sleep 60 && npm run newman",
    "newman": "newman run ./tests/api.postman_collection.json",
    "dropdb": "node ./tests/dropdb.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "coverage": "vitest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "mqtt": "^5.10.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@eslint/js": "^9.14.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.3",
    "babel-jest": "^29.7.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "jest-mock": "^29.7.0",
    "newman": "^6.2.1",
    "nodemon": "^3.1.7",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.0.0",
    "text-table": "^0.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
